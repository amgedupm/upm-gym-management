<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upm.gym.controller.RegisterMembershipController"
            prefWidth="600"
            prefHeight="500">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Register Membership"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="18">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <Label text="Choose Your Plan"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Label text="Plan Type:" style="-fx-font-weight: bold;"/>
            <ChoiceBox fx:id="planChoiceBox" prefWidth="300"/>

            <Label text="Start Date:" style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="startDatePicker" prefWidth="300"/>

            <Label fx:id="summaryLabel"
                   text="Select a plan to see the summary."
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

            <Label fx:id="messageLabel"
                   style="-fx-font-size: 13px;"/>

            <Button text="Subscribe"
                    onAction="#handleSubscribe"
                    prefWidth="300"
                    prefHeight="40"
                    defaultButton="true"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Back to Dashboard"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>