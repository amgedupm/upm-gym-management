<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upm.gym.controller.MyMembershipController"
            prefWidth="600"
            prefHeight="500">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="My Membership"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <Label fx:id="headerLabel"
                   text="Current Membership Details"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane fx:id="detailsGrid" hgap="20" vgap="12">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Plan Type:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="planLabel" text="—"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Status:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="statusLabel" text="—"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Start Date:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="startDateLabel" text="—"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Expiry Date:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label fx:id="expiryDateLabel" text="—"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Days Remaining:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Label fx:id="daysRemainingLabel" text="—"
                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>

            <Label fx:id="messageLabel"
                   style="-fx-font-size: 13px;"/>

            <Button fx:id="cancelButton"
                    text="Cancel Membership"
                    onAction="#handleCancel"
                    prefWidth="300"
                    prefHeight="40"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Back to Dashboard"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>