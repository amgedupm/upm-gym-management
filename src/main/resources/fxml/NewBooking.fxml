<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upm.gym.controller.NewBookingController"
            prefWidth="650"
            prefHeight="600">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Book a Field"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18">
            <padding>
                <Insets top="30" right="50" bottom="30" left="50"/>
            </padding>

            <Label text="New Booking Request"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="14">

                <Label text="Facility:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ChoiceBox fx:id="facilityChoice" prefWidth="280"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Date:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <DatePicker fx:id="datePicker" prefWidth="280"
                            GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Start Time:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <HBox spacing="8" alignment="CENTER_LEFT"
                      GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Spinner fx:id="startHourSpinner" prefWidth="80"/>
                    <Label text=":"/>
                    <Spinner fx:id="startMinuteSpinner" prefWidth="80"/>
                    <Label text="(24-hour format)"
                           style="-fx-font-size: 11px; -fx-text-fill: #777;"/>
                </HBox>

                <Label text="End Time:"
                       style="-fx-font-weight: bold;"
                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <HBox spacing="8" alignment="CENTER_LEFT"
                      GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Spinner fx:id="endHourSpinner" prefWidth="80"/>
                    <Label text=":"/>
                    <Spinner fx:id="endMinuteSpinner" prefWidth="80"/>
                </HBox>
            </GridPane>

            <Label fx:id="summaryLabel"
                   text="Fill in the form to see a summary."
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

            <Label fx:id="messageLabel"
                   style="-fx-font-size: 13px;"/>

            <Button text="Submit Booking Request"
                    onAction="#handleSubmit"
                    prefWidth="280"
                    prefHeight="40"
                    defaultButton="true"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Back to Dashboard"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>