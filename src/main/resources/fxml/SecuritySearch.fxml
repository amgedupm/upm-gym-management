<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upm.gym.controller.SecuritySearchController"
            prefWidth="800"
            prefHeight="600">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="Security — Entry Verification"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label fx:id="welcomeLabel"
                   text="Welcome, Officer"
                   style="-fx-font-size: 14px; -fx-text-fill: #ecf0f1;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="25" right="40" bottom="25" left="40"/>
            </padding>

            <Label text="Verify entry by University ID"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="User ID:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <TextField fx:id="userIdField"
                           promptText="Enter ID and press Enter"
                           prefWidth="250"
                           prefHeight="35"
                           style="-fx-font-size: 14px;"/>
                <Button text="Verify"
                        onAction="#handleVerify"
                        prefWidth="130"
                        prefHeight="35"
                        defaultButton="true"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Button text="Clear"
                        onAction="#handleClear"
                        prefWidth="100"
                        prefHeight="35"/>
            </HBox>

            <Label fx:id="statusLabel"
                   text=""
                   alignment="CENTER"
                   maxWidth="Infinity"
                   prefHeight="60"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Label fx:id="userInfoLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

            <Label text="Approved bookings for today:"
                   fx:id="bookingsHeaderLabel"
                   visible="false"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

            <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS" visible="false">
                <columns>
                    <TableColumn fx:id="idColumn" text="Booking ID" prefWidth="120"/>
                    <TableColumn fx:id="facilityColumn" text="Facility" prefWidth="200"/>
                    <TableColumn fx:id="timeColumn" text="Time Slot" prefWidth="180"/>
                </columns>
                <placeholder>
                    <Label text="No approved bookings for today."/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-text-fill: #c0392b;"/>
        </HBox>
    </bottom>

</BorderPane>