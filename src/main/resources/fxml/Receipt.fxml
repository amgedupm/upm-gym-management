<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upm.gym.controller.ReceiptController"
            prefWidth="700"
            prefHeight="700">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #27ae60;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="✓ Payment Receipt"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18">
            <padding>
                <Insets top="25" right="40" bottom="25" left="40"/>
            </padding>

            <Label text="Thank you for your payment!"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>

            <Label fx:id="referenceLabel"
                   style="-fx-font-size: 12px; -fx-text-fill: #777;"/>

            <HBox spacing="40" alignment="CENTER">

                <VBox spacing="12" prefWidth="320"
                      style="-fx-background-color: #f5f7fa; -fx-background-radius: 8; -fx-padding: 20;">
                    <Label text="RECEIPT DETAILS"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #555;"/>

                    <GridPane hgap="10" vgap="8">
                        <Label text="Member:"
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="memberLabel" text="—"
                               style="-fx-font-size: 12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="ID:"
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="memberIdLabel" text="—"
                               style="-fx-font-size: 12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Plan:"
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="planLabel" text="—"
                               style="-fx-font-size: 12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Start:"
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="startLabel" text="—"
                               style="-fx-font-size: 12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Expiry:"
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="expiryLabel" text="—"
                               style="-fx-font-size: 12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Label text="Card:"
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <Label fx:id="cardLabel" text="—"
                               style="-fx-font-size: 12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                        <Label text="Date:"
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <Label fx:id="timestampLabel" text="—"
                               style="-fx-font-size: 12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                    </GridPane>

                    <Region prefHeight="6"/>

                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-padding: 10 0 0 0; -fx-border-color: #ddd transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                        <Label text="Total Paid:"
                               style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label fx:id="amountLabel" text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </HBox>
                </VBox>

                <VBox alignment="CENTER" spacing="8">
                    <Label text="SCAN AT GATE"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ImageView fx:id="qrImage"
                               fitWidth="180" fitHeight="180"
                               preserveRatio="true"/>
                    <Label fx:id="qrCaption"
                           style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                </VBox>
            </HBox>

            <Label fx:id="messageLabel"
                   style="-fx-font-size: 13px;"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Print Receipt"
                    onAction="#handlePrint"
                    prefWidth="150"
                    prefHeight="35"/>
            <Button text="Done"
                    onAction="#handleDone"
                    prefWidth="150"
                    prefHeight="35"
                    defaultButton="true"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>