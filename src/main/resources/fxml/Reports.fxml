<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upm.gym.controller.ReportsController"
            prefWidth="850"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1e3a5f;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Reports &amp; Analytics"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <Label fx:id="dateLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

            <Label text="Key Metrics"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="20" vgap="20">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>

                <VBox fx:id="card1" spacing="8" alignment="CENTER"
                      prefHeight="100" prefWidth="180"
                      style="-fx-background-color: #3498db; -fx-background-radius: 8; -fx-padding: 15;"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="TOTAL MEMBERS"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="totalMembersLabel" text="—"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>

                <VBox fx:id="card2" spacing="8" alignment="CENTER"
                      prefHeight="100" prefWidth="180"
                      style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-padding: 15;"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="ACTIVE MEMBERSHIPS"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="activeMembershipsLabel" text="—"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>

                <VBox fx:id="card3" spacing="8" alignment="CENTER"
                      prefHeight="100" prefWidth="180"
                      style="-fx-background-color: #9b59b6; -fx-background-radius: 8; -fx-padding: 15;"
                      GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="BOOKINGS TODAY"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="bookingsTodayLabel" text="—"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>

                <VBox fx:id="card4" spacing="8" alignment="CENTER"
                      prefHeight="100" prefWidth="180"
                      style="-fx-background-color: #e67e22; -fx-background-radius: 8; -fx-padding: 15;"
                      GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="PENDING REQUESTS"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="pendingRequestsLabel" text="—"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </GridPane>

            <Label text="Bookings by Facility (This Month)"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <BarChart fx:id="facilityChart" prefHeight="280" legendVisible="false">
                <xAxis>
                    <CategoryAxis fx:id="xAxis" label="Facility"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="yAxis" label="Number of Bookings"/>
                </yAxis>
            </BarChart>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Back to Dashboard"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>