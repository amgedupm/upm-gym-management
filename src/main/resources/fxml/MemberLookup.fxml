<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.upm.gym.controller.MemberLookupController"
            prefWidth="700"
            prefHeight="550">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1e3a5f;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Member Lookup"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <Label text="Search for a member by their University ID."
                   style="-fx-font-size: 14px;"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="User ID:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="userIdField"
                           promptText="e.g. 4410097"
                           prefWidth="200"/>
                <Button text="Search"
                        onAction="#handleSearch"
                        prefWidth="120"
                        prefHeight="30"
                        defaultButton="true"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="messageLabel"
                   style="-fx-font-size: 13px;"/>

            <VBox fx:id="resultBox" spacing="14" visible="false"
                  style="-fx-background-color: #f5f7fa; -fx-background-radius: 5;">
                <padding>
                    <Insets top="20" right="25" bottom="20" left="25"/>
                </padding>

                <Label text="Member Details"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <GridPane hgap="20" vgap="10">
                    <Label text="Full Name:"
                           style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="fullNameLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="University ID:"
                           style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="userIdLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Role:"
                           style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="roleLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Membership:"
                           style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="membershipLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Membership Status:"
                           style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label fx:id="membershipStatusLabel" text="—"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Back to Dashboard"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>